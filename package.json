{
  "name": "@krdn/saju",
  "version": "1.2.2",
  "type": "module",
  "description": "Four Pillars of Destiny (Saju) — multi-school computation engine with prompts and Zod schemas",
  "license": "MIT",
  "keywords": ["saju", "사주", "명리학", "fortune-telling", "korean", "chinese", "japanese", "ziping", "mangpai"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "CHANGELOG.md"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "engines": { "node": ">=20" },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "korean-lunar-calendar": "^0.3.6",
    "lunar-javascript": "1.7.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^4.1.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krdn/saju.git"
  }
}
